# =============================================================================
# WATHEO IoT - Configuración de Variables de Entorno para Producción (.env)
# Copia este archivo como `.env` en la raíz del proyecto al subirlo a internet
# =============================================================================

# Conexión a Base de Datos SQL Server
DB_HOST=Bryan_LAP\SQLEXPRESS
DB_NAME=WATHEO
DB_USER=
DB_PASS=
DB_ENCRYPT=yes
DB_TRUST_CERT=yes

# Clave de autenticación del nodo sensor ESP32 (mínimo 32 caracteres)
WATHEO_API_KEY=cambia_esta_clave_por_un_hash_seguro_de_64_caracteres_hexadecimales

# Origen permitido para CORS (usa * o el dominio de tu frontend en producción)
CORS_ORIGIN=*
